{
  "name": "arccms-debug",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.1"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run dev",
    "export-indexes": "firebase firestore:indexes --database='(default)' > firestore.indexes.json",
    "build": "vite build && cp dist/client/index.html dist/analog/public/__shell.html",
    "test": "vitest",
    "i18n:keys": "node scripts/generate-i18n-keys.mjs",
    "icons:index": "node scripts/generate-icon-index.mjs",
    "deploy:dev": "USE_DEV_ENV=true npm run build && npm run build --prefix functions && firebase deploy --project default --non-interactive --force && npm run seed:dev",
    "deploy:prod": "npm run build && npm run build --prefix functions && firebase deploy --project production --non-interactive --force && npm run seed:prod",
    "seed:dev": "node functions/scripts/call-seed.cjs dev",
    "seed:prod": "node functions/scripts/call-seed.cjs prod"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "^2.6.2",
    "@analogjs/router": "^2.6.2",
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/fire": "^21.0.0-rc.0",
    "@angular/forms": "^21.2.17",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-server": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@jsverse/transloco": "^8.4.0",
    "@ngrx/signals": "^21.1.1",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-bubble-menu": "^3.27.1",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-dropcursor": "^3.27.1",
    "@tiptap/extension-floating-menu": "^3.27.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-list-keymap": "^3.27.1",
    "@tiptap/extension-mention": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-subscript": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-task-item": "^3.27.1",
    "@tiptap/extension-task-list": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-typography": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/extension-youtube": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/suggestion": "^3.27.1",
    "cheerio": "^1.2.0",
    "firebase": "^12.15.0",
    "front-matter": "^4.0.2",
    "jszip": "^3.10.1",
    "marked": "^17.0.6",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "marked-mangle": "^1.1.13",
    "ngx-tiptap": "^14.0.1",
    "prismjs": "^1.30.0",
