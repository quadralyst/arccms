rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.role == 'admin';
    }

    // ============================================================
    // 1. PUBLIC READ + AUTHENTICATED WRITE
    //    SSR (unauthenticated) needs to read these collections.
    // ============================================================

    // ContentTypes - content type definitions, SSR reads for routing
    match /ContentTypes/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Dynamic content, tags, and waitlist-tag collections:
    //   arc_{slug}           → published content, public read
    //   arc_{slug}_drafts    → drafts, authenticated read
    //   Tags_{slug}          → tags, public read
    //   WaitlistUserTags_{id}→ admin only
    // Firestore does NOT support prefix matching in paths, so we
    // use a catch-all wildcard with collection.matches() regex.
    match /{collection}/{docId} {
      // Published content: arc_* but NOT *_drafts → public read
      allow read: if collection.matches('arc_.*') && !collection.matches('.*_drafts');
      // Draft content: arc_*_drafts → authenticated read
      allow read: if collection.matches('arc_.*_drafts') && isAuthenticated();
      // Tags: Tags_* → public read
      allow read: if collection.matches('Tags_.*');
      // WaitlistUserTags: admin read
      allow read: if collection.matches('WaitlistUserTags_.*') && isAdmin();

      // Writes: arc_* and Tags_* → authenticated
      allow write: if (collection.matches('arc_.*') || collection.matches('Tags_.*'))
                   && isAuthenticated();
      // WaitlistUserTags → admin write; allow unauthenticated usageCount increment for signup flow
      allow create, delete: if collection.matches('WaitlistUserTags_.*') && isAdmin();
      allow update: if collection.matches('WaitlistUserTags_.*')
                    && (isAdmin() || request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['usageCount']));

      // PublishedHistory subcollection — version history for published content
      // Written by Cloud Functions (Admin SDK bypasses rules), read by admin
      match /PublishedHistory/{historyId} {
        allow read: if isAdmin();
        allow write: if false; // Only Cloud Functions write history
      }
    }

    // Media metadata - images displayed on public pages
    match /media/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Email lookup - SHA-256 hashed emails for signup flow
    // Public read (check if hash exists), authenticated write
    match /email_lookup/{hashId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ============================================================
    // 2. SETTINGS - Per-document access control
    // ============================================================

    match /Settings/{settingId} {
      // Public-safe settings documents (no sensitive data).
      // `localization` is public-read on purpose: the public language switcher
      // and the SPA fallback renderer both need the site's language list before
      // any user is authenticated. Writes stay admin-only via the catch-all below.
      allow read: if settingId in ['email_status', 'site-usage', 'misc', 'cache', 'global-message', 'users', 'localization'];
      // Frontend-managed settings — any authenticated user can read/write.
      // UI routes are admin-gated via role guard; rules only enforce auth.
      allow read, write: if isAuthenticated() && settingId in [
        'about', 'site', 'email', 'email_status', 'analytics',
        'integrations', 'users', 'global-message', 'misc',
        'site-usage', 'onboarding_status'
      ];
      // analytics_status — authenticated read (frontend listener for GA connect flow);
      // writes are Cloud Function only (Admin SDK bypasses rules).
      allow read: if settingId == 'analytics_status' && isAuthenticated();
      // dodo-payments — holds API keys + webhook secret. Admin only (secrets are
      // also masked on read in the UI layer). Listed explicitly for clarity.
      allow read, write: if settingId == 'dodo-payments' && isAdmin();
      // Everything else (e.g. analytics_status, future sensitive docs) — admin only
      allow read, write: if isAdmin();

      // Email connection test document (single document)
      // Allow unauthenticated users to read/write for onboarding flow
      match /emailTestingConnection {
        allow read, write: if true;
      }
    }

    // ============================================================
    // 3. USERS - Authenticated read, owner/admin write
    // ============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() || isAdmin();
      // Doc IDs are auto-generated; compare auth uid against the uid field in the doc.
      // Admin can update any user doc (migration re-keying). A user may update their
      // own doc EXCEPT the premium entitlement fields — those are written only by
      // Cloud Functions (Admin SDK bypasses rules) so users cannot self-grant access.
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.uid == request.auth.uid
         && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['isPro', 'premiumType', 'premiumTierRank', 'premiumStatus',
                       'premiumExpiresAt', 'provider', 'providerSubscriptionId', 'providerCustomerId',
                       'premiumTrialReminderSent', 'premiumEventAt', 'updatesUntil',
                       'premiumTierLabel', 'premiumDiscountCode', 'creditBalance']));
      allow delete: if isAdmin();
    }

    // ============================================================
    // PAYMENTS (Dodo) — products, transactions, raw webhook log
    // ============================================================

    // Products — public read of active products (pricing page); admin write.
    match /Products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Transactions — owner or admin read; never written by clients (Cloud Functions only).
    match /Transactions/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // WebhookEvents — raw forensic log. Admin read for debugging; Cloud Functions only write.
    match /WebhookEvents/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // CreditLedger — append-only prepaid-credit ledger. Owner or admin read;
    // never written by clients (Cloud Functions / consumeCredits callable only).
    match /CreditLedger/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Publish queue — admin writes trigger docs; Cloud Function processes them
    match /_publish_queue/{docId} {
      allow read: if false;       // Cloud Functions use Admin SDK (bypasses rules)
      allow write: if isAuthenticated();
    }

    // ============================================================
    // 4. ADMIN-ONLY COLLECTIONS
    // ============================================================

    // Legacy collections - only accessible by admin during migration
    match /DraftContents/{docId} {
      allow read, write: if isAdmin();
    }

    match /Contents/{docId} {
      allow read, write: if isAdmin();
    }


    match /AnalyticsDashboards/{docId} {
      allow read, write: if isAdmin();
    }

    match /EmailTemplate/{docId} {
      allow read, write: if isAdmin();
    }

    match /BroadcastEmails/{docId} {
      allow read, write: if isAdmin();
    }

    // Broadcast continuation queue - Cloud Functions only (Admin SDK)
    match /_broadcast_continue/{docId} {
      allow read, write: if false;
    }

    // Email send counters - Cloud Functions only (Admin SDK)
    match /_email_counters/{counterId} {
      allow read, write: if false;
    }

    match /EmailLogs/{docId} {
      allow read, write: if isAdmin();
    }

    // Legacy singular collection (all new code uses 'EmailLogs'). Kept for backward compatibility.
    match /EmailLog/{docId} {
      allow read, write: if isAdmin();
    }

    // Email system (Phase 3+): Contacts, Suppression, signup OTPs are
    // functions-only writes; admins may read for the admin UIs. Lists are
    // admin-managed (memberCount is maintained by functions but admin writes are
    // allowed for manual list management).
    match /Contacts/{emailHash} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions (Admin SDK) only
    }

    match /Suppression/{emailHash} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    match /signup_otps/{emailHash} {
      allow read, write: if false; // Cloud Functions only (never client-readable)
    }

    // Erasure receipts (adminDeleteContact). Hash-keyed and address-free by
    // construction, so admin read is safe — it is the operator's proof a deletion
    // request was actioned. Write is functions-only for the same reason a contact
    // is: an editable audit trail is not an audit trail.
    match /ErasureLog/{emailHash} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // NOTE (U4.5): `Settings/contact_fields` needs no rule of its own — the
    // `Settings/{settingId}` catch-all above already grants admins read/write, and
    // admin read is all the Fields page, the form mapping picker and the contact
    // drawer require. A `write: if false` block here would be misleading: rules
    // OR together, so the catch-all would still permit the write.

    match /Lists/{listId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Global audience tags (U2). Distinct from the CMS `Tags_{slug}` content
    // taxonomy below, which is public-read — these label contacts and are
    // admin-only. Doc id is a slug of the label; `usageCount` is maintained by
    // functions but admin writes are allowed for label/colour management.
    match /ContactTags/{tagId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Notifications (Phase 5): a user reads their own and may only flip `read`;
    // create/delete are functions/admin only.
    match /Notifications/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }

    // Event bus + announcements: functions-only writes; admins read for the UIs.
    match /AppEvents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /Announcements/{id} {
      allow read: if isAdmin();
      allow write: if false; // created via the sendAnnouncement callable
    }

    // Drip campaigns (Phase 7): admin-managed. Enrollments are functions-only.
    match /DripCampaigns/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /DripEnrollments/{id} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ============================================================
    // 5. WAITLIST COLLECTIONS
    //    Signup flow runs client-side without authentication.
    //    Future: migrate to Cloud Functions for proper security.
    // ============================================================

    // Waitlists main documents - public read for signup pages
    match /Waitlists/{waitlistId} {
      allow read: if true;
      // Admin can write any field
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    // Allow unauthenticated signup flow to increment totalSignups only
                    || request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly(['totalSignups']);

      // Users subcollection - signup flow (unauthenticated)
      match /users/{userId} {
        // #51: NO public read. This carried `allow read: if true`, verified exploitable —
        // an unauthenticated request using only the web API key (which ships in the
        // frontend bundle) could page every signup, raw email addresses included.
        //
        // The rule existed because the browser read these documents: the leaderboard and
        // user-detail pages, the signup duplicate check, the OTP confirm path, the
        // referrer lookup and the member count. All of those now go through callables —
        // getPublicLeaderboard, getPublicMemberView, joinForm, creditReferral — which
        // return an explicit field allowlist and masked addresses.
        //
        // Creates stay open: a signup writes its own member doc, and the U5 lockdown
        // already restricts which fields an update may touch.
        allow read: if isAdmin();
        allow create: if request.resource.data.keys().hasAll(['email', 'waitlistId'])
                      && request.resource.data.email is string
                      && request.resource.data.email.size() > 0
                      && request.resource.data.email.size() < 255;
        // U5 item 5: verification, queue position and referral counts are written ONLY by
        // Cloud Functions (finalizeFormSignup / verifyFormOtp / the referral triggers).
        // Until U5 these were client-writable, so anyone could mark themselves
        // verified, jump the queue, or inflate their referral count with a single
        // Firestore write. Removed from the whitelist: emailVerified, isConfirmed,
        // verificationCode, verificationExpires, verifiedAt, queuePosition,
        // totalReferrals. Creates are unaffected — a signup still creates its own doc.
        allow update: if isAdmin() || request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['isSubscribed', 'firstName', 'leaderboardLink',
                                   'tags', 'referredBy']);
        allow delete: if isAdmin();

        // Notes subcollection - admin-only internal annotations on subscribers
        match /notes/{noteId} {
          allow read, write: if isAdmin();
        }

        // U6: referrals live under the member that earned them, so the crediting
        // trigger takes the form and the member straight from the document path
        // instead of trusting fields on the record. Same permissions the block under
        // WaitlistedUsers had — public read for the leaderboard, unauthenticated
        // create for the signup flow — but `totalReferrals` itself stays
        // functions-only (see the member update rule above), so a forged referral
        // record still cannot inflate a count directly.
        match /referrals/{referralId} {
          // #51: read through getPublicMemberView, which masks the referred addresses.
          // Public read here handed out the email of everyone a member ever referred.
          allow read: if isAdmin();
          allow create: if request.resource.data.keys().hasAll(['referredEmail'])
                        && request.resource.data.referredEmail is string
                        && request.resource.data.referredEmail.size() > 0
                        && request.resource.data.referredEmail.size() < 255;
          allow update: if isAdmin() || request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(['status', 'completedAt']);
          allow delete: if isAdmin();
        }
      }
    }

    // WaitlistedUsers - retired global registry (U6). Read-only for admins; see the
    // frozen-write note below.
    match /WaitlistedUsers/{userId} {
      // #51: NO public read — the worst of the four, since it exposed every signup
      // across every form in one collection. Nothing public reads it now:
      // getPublicMemberView resolves a legacy `waitlistedUserId` through the member
      // doc's back-reference, so leaderboard links already sent by email still work.
      allow read: if isAdmin();
      // U6 cutover: FROZEN. Nothing writes this collection any more — joinForm creates
      // only a member doc, finalizeFormSignup's mirror is gone, and the two OTP triggers
      // that fired on it are deleted. Records written before the cutover are kept so
      // already-sent links and the historical importers still resolve, but they are now
      // read-only.
      //
      // Admin writes stay permitted so the export/import tooling and any manual repair
      // still work. Physical deletion of the collection is a deliberate admin step after
      // verification, not something these rules do.
      allow create, update: if isAdmin();
      allow delete: if isAdmin();

      // Referrals subcollection - leaderboard + signup flow
      match /referrals/{referralId} {
        // #51: same reasoning as the parent. U6 moved referrals under the member doc;
        // these are the pre-migration records.
        allow read: if isAdmin();
        allow create: if request.resource.data.keys().hasAll(['referredEmail'])
                      && request.resource.data.referredEmail is string
                      && request.resource.data.referredEmail.size() > 0
                      && request.resource.data.referredEmail.size() < 255;
        allow update: if isAdmin() || request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['status', 'completedAt']);
        allow delete: if isAdmin();
      }
    }

    // ============================================================
    // No catch-all needed - Firestore denies unmatched paths by default
    // ============================================================
  }
}
