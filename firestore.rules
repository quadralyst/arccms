rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // ------------------------------------------------------------
    // Helpers for app rules (firestore.app.rules, docs/app-rules.md).
    // Apps call these, plus isAdmin() and isEditor() below; keep their
    // names and meaning stable.
    // ------------------------------------------------------------

    // Any signed-in person.
    function isSignedIn() {
      return request.auth != null;
    }

    // The signed-in person owns this users record. Reads the `arccms_uid`
    // claim (functions/src/users/claims.ts), so it costs no document read. A
    // token without the claim owns nothing: the browser refreshes the claim
    // at sign-in, so a missing one means deny.
    function ownsUserRecord(userDocId) {
      return isSignedIn() && request.auth.token.get('arccms_uid', '') == userDocId;
    }

    // The ArcCMS role is the `arccms_role` claim (functions/src/users/claims.ts),
    // never a plain `role`: an app sharing the sign-in pool may give its own
    // admins `role: 'admin'` (docs/coexistence-spec.md, CO-D7).
    function arcRole() {
      return request.auth.token.get('arccms_role', '');
    }

    function isAdmin() {
      return isAuthenticated() && arcRole() == 'admin';
    }

    // Content staff: may write content types, content, tags, media and the
    // publish queue. Admins, plus an `editor` role that CO1 reserves
    // (docs/coexistence-spec.md). Nothing in the app grants `editor` today and
    // every admin route is admin-only, so in practice this is admins. The claim
    // comes from onUserRoleChange, and only admins or the Admin SDK can set a
    // user's `role` (see the users rules below), so nobody can self-assign it.
    function isEditor() {
      return isAdmin() || (isAuthenticated() && arcRole() == 'editor');
    }

    // ============================================================
    // 1. PUBLIC READ + AUTHENTICATED WRITE
    //    SSR (unauthenticated) needs to read these collections.
    // ============================================================

    // ContentTypes - content type definitions, SSR reads for routing.
    // Writes are staff only: any signed-in user used to be able to rewrite a
    // content type, and deleting one cascades through its content.
    match /ContentTypes/{docId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Authors - who writes for the site (docs/discoverability-spec.md, D-D5).
    // Public read: the static pages print the same name, bio, photo and
    // profile links on every byline and in the Article JSON-LD, and the SPA
    // fallback needs them to render the same box. Nothing private is stored
    // here by design (no email, no user id). Admin write.
    match /Authors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Dynamic content, tags, and waitlist-tag collections:
    //   arc_{slug}           → published content, public read
    //   arc_{slug}_drafts    → drafts, staff read
    //   Tags_{slug}          → tags, public read
    //   WaitlistUserTags_{id}→ admin only
    // Firestore does NOT support prefix matching in paths, so we
    // use a catch-all wildcard with collection.matches() regex.
    match /{collection}/{docId} {
      // Published content: arc_* but NOT *_drafts → public read
      allow read: if collection.matches('arc_.*') && !collection.matches('.*_drafts');
      // Draft content: arc_*_drafts → staff read (only the admin editor reads drafts)
      allow read: if collection.matches('arc_.*_drafts') && isEditor();
      // Tags: Tags_* → public read
      allow read: if collection.matches('Tags_.*');
      // WaitlistUserTags: admin read
      allow read: if collection.matches('WaitlistUserTags_.*') && isAdmin();

      // Writes: arc_* and Tags_* → staff. These were writable by any signed-in
      // user, and sign-up is open, so anyone could publish or deface content.
      allow write: if (collection.matches('arc_.*') || collection.matches('Tags_.*'))
                   && isEditor();
      // WaitlistUserTags → admin write; allow unauthenticated usageCount increment for signup flow
      allow create, delete: if collection.matches('WaitlistUserTags_.*') && isAdmin();
      allow update: if collection.matches('WaitlistUserTags_.*')
                    && (isAdmin() || request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['usageCount']));

      // PublishedHistory subcollection — version history for published content
      // Written by Cloud Functions (Admin SDK bypasses rules), read by admin
      match /PublishedHistory/{historyId} {
        allow read: if isAdmin();
        allow write: if false; // Only Cloud Functions write history
      }

      // translations/{lang} subcollection — per-language content variants (M2).
      // Mirrors the parent's access model:
      //   arc_*_drafts → authored in the editor, so staff read/write
      //   arc_*        → published variants, public read (the language pages
      //                  and the SPA fallback are public); written only by the
      //                  publish pipeline, which bypasses rules via Admin SDK.
      match /translations/{lang} {
        allow read, write: if collection.matches('arc_.*_drafts') && isEditor();
        allow read: if collection.matches('arc_.*') && !collection.matches('.*_drafts');
      }
    }

    // Media metadata - images displayed on public pages. Staff write: the
    // media library is an admin tool. Members set a profile photo through
    // their own storage folder (storage.rules, avatars/{uid}) and never
    // create media documents.
    match /media/{docId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Email lookup - SHA-256 hashed emails for signup flow
    // Public read (check if hash exists). Functions keep it in step with the
    // users records (onUserCreated, onUserDelete, the sign-in callables); only
    // admins write it from the browser (Users, Delete). Any signed-in writer
    // could make a registered address look unregistered (review S5).
    match /email_lookup/{hashId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // 2. SETTINGS - Per-document access control
    // ============================================================

    match /Settings/{settingId} {
      // Public-safe settings documents (no sensitive data).
      // `localization` is public-read on purpose: the public language switcher
      // and the SPA fallback renderer both need the site's language list before
      // any user is authenticated. Writes stay admin-only via the catch-all below.
      // `onboarding_status` is public-read for the same class of reason: the
      // home page and the signup page decide whether to send a visitor to the
      // setup wizard before anyone is signed in, and that decision is now made
      // from this flag rather than from the emptiness of `email_lookup`. It
      // holds only `completed` and two timestamps — it says whether the site
      // finished its setup, which any visitor to an unfinished site can see
      // anyway. Writes are admin only, via the catch-all below.
      // `feedback` holds only whether the feedback button is on (docs/feedback.md);
      // admins switch it on the Feedback page.
      // `about` is public-read as well: it is the site's published identity
      // (name, URL, address, logo, description, profile links, public contact
      // email), the same data every static page already carries as schema.org
      // JSON-LD. The SPA fallback pages need it to emit the same nodes
      // (docs/discoverability-spec.md, D1). Nothing secret lives there.
      allow read: if settingId in ['email_status', 'site-usage', 'misc', 'cache', 'global-message', 'users', 'localization', 'onboarding_status', 'about', 'feedback'];
      // Every write below is admin only, including the public-read documents
      // above (review S5, 2026-09-28). `about`, `site`, `email_status`,
      // `global-message`, `misc`, `site-usage` and `onboarding_status` used to be
      // readable and writable by any signed-in account: a member of a site with
      // open sign-up, or a host app's user in a shared project, could change the
      // site banner, its identity, the email flags, or send visitors back to the
      // setup wizard. Only the admin pages and the setup wizard (after
      // claimFirstAdmin) write them, and `claimFirstAdmin` itself writes
      // `onboarding_status` when it makes the first admin.
      //
      // `users` (public read above, admin write below) holds `defaultRole`,
      // which onUserRoleChange applies to every self sign-up. A signed-in user
      // who could write it could set it to 'admin' and sign up a second account
      // as an admin.
      //
      // `email`, `integrations` and `analytics` are admin read as well: all three
      // carry live secrets. `email` holds smtp.password / gmail.password /
      // resend.apiKey, `integrations` holds the Unsplash secretKey and the geo
      // API key, `analytics` holds the Google OAuth clientSecret. Rules are the
      // only gate a direct SDK call meets, and "authenticated" means any
      // registered visitor, not an admin.
      // analytics_status — authenticated read (frontend listener for GA connect flow);
      // writes are Cloud Function only (Admin SDK bypasses rules).
      allow read: if settingId == 'analytics_status' && isAuthenticated();
      // search_status — per-source counts from the reindex tool. Admin read;
      // writes are Cloud Function only.
      allow read: if settingId == 'search_status' && isAdmin();
      // discoverability — default author (D2), crawler policy and IndexNow
      // key (D3). Admin only; functions bake what the public needs into the
      // static files, so no public read is required.
      allow read, write: if settingId == 'discoverability' && isAdmin();
      // dodo-payments — holds API keys + webhook secret. Admin only (secrets are
      // also masked on read in the UI layer). Listed explicitly for clarity.
      allow read, write: if settingId == 'dodo-payments' && isAdmin();
      // Everything else — `email`, `integrations`, `analytics`, `analytics_status`,
      // and any future sensitive doc — admin only.
      //
      // NOTE: there is deliberately no `emailTestingConnection` rule here. That
      // document used to carry provider credentials to a Firestore-triggered
      // connection test, guarded by a nested `match /emailTestingConnection` that
      // resolved to the collection path `Settings/{settingId}/emailTestingConnection`
      // — no document wildcard, so it granted nothing and the catch-all above did
      // the real work. A downstream fork "consolidated" that dead rule into a live
      // `settingId == 'emailTestingConnection'` and made the credentials world
      // readable and world writable. The document is gone: the connection test is
      // now the `testSmtpConfigConnection` callable, which authenticates the caller
      // and never persists the payload. Do not add a rule for it.
      allow read, write: if isAdmin();
    }

    // ============================================================
    // 3. USERS - own doc or admin
    // ============================================================

    // Doc IDs are auto-generated, so ownership is the `uid` field, not the id.
    //
    // `role` is the source of the Auth custom claim that isAdmin() checks
    // (functions/src/users/syncUserRole.ts copies it). So a user must never be
    // able to set it:
    //   - create: admins only. Every sign-up creates its record on the server
    //     (createAccountRecord, ensureGoogleAccount, the phone callables,
    //     adminCreateUser), which checks the email, the role and whether
    //     sign-ups are open. A client-created record could carry another
    //     person's email, a plan or credits (review F).
    //   - update: never `role`, `uid`, the admin switches (`isActive`,
    //     `status`), or the premium fields; `emailVerified` may only go to false.
    //   - the first admin of a fresh install comes from the `claimFirstAdmin`
    //     callable, which grants admin once and only while no admin exists.
    // Reads are own doc or admin. Client queries on `users` must therefore
    // filter on `uid == request.auth.uid` (getCurrentUserByUid does).
    function isOwnUserDoc() {
      return isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Passwords live in Firebase Auth only, never in a user record.
    function hasNoPassword(data) {
      return !('password' in data);
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwnUserDoc();
      allow create: if hasNoPassword(request.resource.data) && isAdmin();
      // Admin can update any user doc (migration re-keying, role changes). A
      // user may update their own doc EXCEPT the fields above. `phone` and
      // `email` are sign-in methods, changed only by the server after a code
      // (functions/src/auth/linkIdentifiers.ts); authOwner is Admin SDK only
      // (CO-D16). The premium
      // entitlement fields are written only by Cloud Functions (Admin SDK
      // bypasses rules) so users cannot self-grant access.
      allow update: if hasNoPassword(request.resource.data) && (isAdmin() ||
        (isOwnUserDoc()
         && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'uid', 'isActive', 'status', 'authOwner',
                       'email', 'phone', 'phoneVerified', 'detachedAt', 'detachedReason',
                       'isPro', 'premiumType', 'premiumTierRank', 'premiumStatus',
                       'premiumExpiresAt', 'provider', 'providerSubscriptionId', 'providerCustomerId',
                       'premiumTrialReminderSent', 'premiumEventAt', 'updatesUntil',
                       'premiumTierLabel', 'premiumDiscountCode', 'creditBalance'])
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['emailVerified'])
             || request.resource.data.emailVerified == false)));
      allow delete: if isAdmin();
    }

    // First-admin sentinel, written once by the claimFirstAdmin callable.
    // Admin SDK only: a client that could delete it could claim admin again.
    match /_system/{docId} {
      allow read, write: if false;
    }

    // ============================================================
    // PAYMENTS (Dodo) — products, transactions, raw webhook log
    // ============================================================

    // Products — public read of active products (pricing page); admin write.
    match /Products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Transactions — owner or admin read; never written by clients (Cloud Functions only).
    match /Transactions/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // WebhookEvents — raw forensic log. Admin read for debugging; Cloud Functions only write.
    match /WebhookEvents/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // CreditLedger — append-only prepaid-credit ledger. Owner or admin read;
    // never written by clients (Cloud Functions / consumeCredits callable only).
    match /CreditLedger/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Search index — written by Cloud Functions only, read by the `search`
    // callable only. Closed to clients on purpose: the callable is where
    // scope is enforced (docs/search-spec.md, S-D1 and S-D8).
    match /SearchIndex/{entryId} {
      allow read, write: if false;
    }

    // Publish queue: staff write trigger docs; Cloud Function processes them
    match /_publish_queue/{docId} {
      allow read: if false;       // Cloud Functions use Admin SDK (bypasses rules)
      allow write: if isEditor();
    }

    // ============================================================
    // 4. ADMIN-ONLY COLLECTIONS
    // ============================================================

    // Legacy collections - only accessible by admin during migration
    match /DraftContents/{docId} {
      allow read, write: if isAdmin();
    }

    match /Contents/{docId} {
      allow read, write: if isAdmin();
    }


    match /AnalyticsDashboards/{docId} {
      allow read, write: if isAdmin();
    }

    match /EmailTemplate/{docId} {
      allow read, write: if isAdmin();
    }

    match /BroadcastEmails/{docId} {
      allow read, write: if isAdmin();
    }

    // Broadcast continuation queue - Cloud Functions only (Admin SDK)
    match /_broadcast_continue/{docId} {
      allow read, write: if false;
    }

    // Email send counters - Cloud Functions only (Admin SDK)
    match /_email_counters/{counterId} {
      allow read, write: if false;
    }

    match /EmailLogs/{docId} {
      allow read, write: if isAdmin();
    }

    // Legacy singular collection (all new code uses 'EmailLogs'). Kept for backward compatibility.
    match /EmailLog/{docId} {
      allow read, write: if isAdmin();
    }

    // Email system (Phase 3+): Contacts, Suppression, signup OTPs are
    // functions-only writes; admins may read for the admin UIs. Lists are
    // admin-managed (memberCount is maintained by functions but admin writes are
    // allowed for manual list management).
    match /Contacts/{emailHash} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions (Admin SDK) only
    }

    match /Suppression/{emailHash} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    match /signup_otps/{emailHash} {
      allow read, write: if false; // Cloud Functions only (never client-readable)
    }

    // Phone sign-in (functions/src/auth). Codes, PIN hashes, the number to
    // account index and rate-limit counters are Cloud Functions only: the
    // browser asks the callables, never these documents.
    match /phone_otps/{phoneHash} {
      allow read, write: if false;
    }
    match /phone_index/{phoneHash} {
      allow read, write: if false;
    }
    match /auth_pins/{uid} {
      allow read, write: if false;
    }
    match /_rate_limits/{key} {
      allow read, write: if false;
    }

    // A phone number or email moved from one account to another. Admin read;
    // written only by the functions that move them.
    match /account_transfers/{transferId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Every SMS sent (or, with the log provider, only recorded). Admin read.
    match /SmsLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // App install counters by day (trackPwaEvent, docs/pwa.md). Admin read.
    match /PwaStats/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Feedback button (docs/feedback.md). A signed-in person creates their own,
    // new, with files only from their own folder; the onFeedbackCreated function
    // adds `sender`. Admins read, mark done, and delete.
    match /Feedback/{feedbackId} {
      allow read, update, delete: if isAdmin();
      allow create: if isValidNewFeedback(feedbackId);
    }

    // A file in the sender's own folder for this feedback, compared part by
    // part: `[upload folder/]users/{their record}/feedback/{id}/{name}`. Never a
    // pattern built from the ids, since the sender picks the feedback id and an
    // id like `x|.*` would turn the pattern into "any path" (review F): the
    // admin's Delete then deleted whatever file the feedback named.
    function isFeedbackFile(path, feedbackId, names) {
      return path is string && isFeedbackFileParts(path.split('/'), feedbackId, names);
    }

    function isFeedbackFileParts(parts, feedbackId, names) {
      let at = parts.size() - 5;
      return (at == 0 || (at == 1 && parts[0].matches('[A-Za-z0-9_-]+')))
        && parts[at] == 'users'
        && parts[at + 1] == request.auth.token.get('arccms_uid', '')
        && parts[at + 2] == 'feedback'
        && parts[at + 3] == feedbackId
        && parts[at + 4] in names;
    }

    function isValidNewFeedback(feedbackId) {
      let d = request.resource.data;
      return isSignedIn()
        && request.auth.token.get('arccms_uid', '') != ''
        && d.keys().hasOnly(['uid', 'userDocId', 'message', 'screenshotPath', 'voicePath', 'voiceSeconds', 'page', 'device', 'status', 'createdAt'])
        && d.keys().hasAll(['uid', 'userDocId', 'message', 'page', 'device', 'status', 'createdAt'])
        && d.uid == request.auth.uid
        && d.userDocId == request.auth.token.arccms_uid
        && d.status == 'new'
        && d.createdAt == request.time
        && d.message is string && d.message.size() <= 5000
        && (d.message.size() > 0 || 'voicePath' in d)
        && d.page is map && d.device is map
        && (!('screenshotPath' in d) || isFeedbackFile(d.screenshotPath, feedbackId, ['screenshot.jpg']))
        && (!('voicePath' in d) || isFeedbackFile(d.voicePath, feedbackId, ['voice.mp4', 'voice.webm', 'voice.ogg']))
        && (!('voiceSeconds' in d) || (d.voiceSeconds is number && d.voiceSeconds <= 180));
    }

    // Erasure receipts (adminDeleteContact). Hash-keyed and address-free by
    // construction, so admin read is safe — it is the operator's proof a deletion
    // request was actioned. Write is functions-only for the same reason a contact
    // is: an editable audit trail is not an audit trail.
    match /ErasureLog/{emailHash} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // NOTE (U4.5): `Settings/contact_fields` needs no rule of its own — the
    // `Settings/{settingId}` catch-all above already grants admins read/write, and
    // admin read is all the Fields page, the form mapping picker and the contact
    // drawer require. A `write: if false` block here would be misleading: rules
    // OR together, so the catch-all would still permit the write.

    match /Lists/{listId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Global audience tags (U2). Distinct from the CMS `Tags_{slug}` content
    // taxonomy below, which is public-read — these label contacts and are
    // admin-only. Doc id is a slug of the label; `usageCount` is maintained by
    // functions but admin writes are allowed for label/colour management.
    match /ContactTags/{tagId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Notifications (Phase 5): a user reads their own and may only flip `read`;
    // create/delete are functions/admin only.
    match /Notifications/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }

    // Event bus + announcements: functions-only writes; admins read for the UIs.
    match /AppEvents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /Announcements/{id} {
      allow read: if isAdmin();
      allow write: if false; // created via the sendAnnouncement callable
    }

    // Drip campaigns (Phase 7): admin-managed. Enrollments are functions-only.
    match /DripCampaigns/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /DripEnrollments/{id} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ============================================================
    // 5. WAITLIST COLLECTIONS
    //    Signup flow runs client-side without authentication.
    //    Future: migrate to Cloud Functions for proper security.
    // ============================================================

    // Waitlists main documents - public read for signup pages
    match /Waitlists/{waitlistId} {
      allow read: if true;
      // Admin can write any field
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    // Allow unauthenticated signup flow to increment totalSignups only
                    || request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly(['totalSignups']);

      // Users subcollection - signup flow (unauthenticated)
      match /users/{userId} {
        // #51: NO public read. This carried `allow read: if true`, verified exploitable —
        // an unauthenticated request using only the web API key (which ships in the
        // frontend bundle) could page every signup, raw email addresses included.
        //
        // The rule existed because the browser read these documents: the leaderboard and
        // user-detail pages, the signup duplicate check, the OTP confirm path, the
        // referrer lookup and the member count. All of those now go through callables —
        // getPublicLeaderboard, getPublicMemberView, joinForm, creditReferral — which
        // return an explicit field allowlist and masked addresses.
        //
        // Creates stay open: a signup writes its own member doc, and the U5 lockdown
        // already restricts which fields an update may touch.
        allow read: if isAdmin();
        allow create: if request.resource.data.keys().hasAll(['email', 'waitlistId'])
                      && request.resource.data.email is string
                      && request.resource.data.email.size() > 0
                      && request.resource.data.email.size() < 255;
        // U5 item 5: verification, queue position and referral counts are written ONLY by
        // Cloud Functions (finalizeFormSignup / verifyFormOtp / the referral triggers).
        // Until U5 these were client-writable, so anyone could mark themselves
        // verified, jump the queue, or inflate their referral count with a single
        // Firestore write. Removed from the whitelist: emailVerified, isConfirmed,
        // verificationCode, verificationExpires, verifiedAt, queuePosition,
        // totalReferrals. Creates are unaffected — a signup still creates its own doc.
        allow update: if isAdmin() || request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['isSubscribed', 'firstName', 'leaderboardLink',
                                   'tags', 'referredBy']);
        allow delete: if isAdmin();

        // Notes subcollection - admin-only internal annotations on subscribers
        match /notes/{noteId} {
          allow read, write: if isAdmin();
        }

        // U6: referrals live under the member that earned them, so the crediting
        // trigger takes the form and the member straight from the document path
        // instead of trusting fields on the record. Same permissions the block under
        // WaitlistedUsers had — public read for the leaderboard, unauthenticated
        // create for the signup flow — but `totalReferrals` itself stays
        // functions-only (see the member update rule above), so a forged referral
        // record still cannot inflate a count directly.
        match /referrals/{referralId} {
          // #51: read through getPublicMemberView, which masks the referred addresses.
          // Public read here handed out the email of everyone a member ever referred.
          allow read: if isAdmin();
          allow create: if request.resource.data.keys().hasAll(['referredEmail'])
                        && request.resource.data.referredEmail is string
                        && request.resource.data.referredEmail.size() > 0
                        && request.resource.data.referredEmail.size() < 255;
          allow update: if isAdmin() || request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(['status', 'completedAt']);
          allow delete: if isAdmin();
        }
      }
    }

    // WaitlistedUsers - retired global registry (U6). Read-only for admins; see the
    // frozen-write note below.
    match /WaitlistedUsers/{userId} {
      // #51: NO public read — the worst of the four, since it exposed every signup
      // across every form in one collection. Nothing public reads it now:
      // getPublicMemberView resolves a legacy `waitlistedUserId` through the member
      // doc's back-reference, so leaderboard links already sent by email still work.
      allow read: if isAdmin();
      // U6 cutover: FROZEN. Nothing writes this collection any more — joinForm creates
      // only a member doc, finalizeFormSignup's mirror is gone, and the two OTP triggers
      // that fired on it are deleted. Records written before the cutover are kept so
      // already-sent links and the historical importers still resolve, but they are now
      // read-only.
      //
      // Admin writes stay permitted so the export/import tooling and any manual repair
      // still work. Physical deletion of the collection is a deliberate admin step after
      // verification, not something these rules do.
      allow create, update: if isAdmin();
      allow delete: if isAdmin();

      // Referrals subcollection - leaderboard + signup flow
      match /referrals/{referralId} {
        // #51: same reasoning as the parent. U6 moved referrals under the member doc;
        // these are the pre-migration records.
        allow read: if isAdmin();
        allow create: if request.resource.data.keys().hasAll(['referredEmail'])
                      && request.resource.data.referredEmail is string
                      && request.resource.data.referredEmail.size() > 0
                      && request.resource.data.referredEmail.size() < 255;
        allow update: if isAdmin() || request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['status', 'completedAt']);
        allow delete: if isAdmin();
      }
    }

    // ============================================================
    // App rules. `npm run rules:build` (run by every deploy) puts the
    // install's firestore.app.rules here, inside this same scope, so they
    // can call the helpers above. Keep the marker on a line of its own.
    // ============================================================
    // @arc-app-rules

    // ============================================================
    // No catch-all needed - Firestore denies unmatched paths by default
    // ============================================================
  }
}
