{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "target": "es2022"
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
