rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // ------------------------------------------------------------
    // Helpers for app rules (storage.app.rules, docs/app/rules-and-indexes.html).
    // The same names and meaning as in firestore.rules.
    // ------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // The `arccms_role` claim, never a plain `role` (see firestore.rules, arcRole()).
    function arcRole() {
      return request.auth.token.get('arccms_role', '');
    }

    function isAdmin() {
      return isSignedIn() && arcRole() == 'admin';
    }

    // Same claim the Firestore rules use (firestore.rules, isEditor()). It is
    // set by the onUserRoleChange Cloud Function, and only admins or the Admin
    // SDK can change a user's role.
    function isEditor() {
      return isAuthenticated() && (arcRole() == 'admin' || arcRole() == 'editor');
    }

    // The signed-in person owns this users record (the `arccms_uid` claim).
    function ownsUserRecord(userDocId) {
      return isSignedIn() && request.auth.token.get('arccms_uid', '') == userDocId;
    }

    // The session came from the app's own sign-in token, not Google, a password
    // or a phone code. For app rules only (firestore.rules, signedInByApp()).
    function signedInByApp() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'custom';
    }

    function isSmallImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Everything the admin tools write: the media library (mediaImages/...),
    // the data import/export files, and any other path. Staff only: this was
    // "any signed-in user", and sign-up is open, so anyone could upload to the
    // bucket or overwrite and delete the site's images.
    //
    // Public read, because images are served on public pages and SSR, except
    // the per-user folders: `users/{userDocId}/...` at the bucket root or under
    // one upload folder (`arccms/users/...`, the install's storagePrefix). A
    // folder named `users` in the first two levels is therefore never public.
    match /{fileName} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /{first}/{second}/{rest=**} {
      allow read: if first != 'users' && second != 'users';
      allow write: if isEditor();
    }

    // Per-user folders (docs/app/account-contract.html): the owner and admins may
    // read. Apps grant writes in storage.app.rules, with their own size and
    // type limits. Deleting the account deletes the folder.
    match /users/{userDocId}/{rest=**} {
      allow read: if ownsUserRecord(userDocId) || isAdmin();
    }
    match /{prefix}/users/{userDocId}/{rest=**} {
      allow read: if ownsUserRecord(userDocId) || isAdmin();
    }

    // Feedback button files (docs/features/feedback.html): the screenshot and the voice
    // note, in the sender's own folder. Create only; admins delete them with the
    // feedback, and deleting the account deletes the folder. Only the two files
    // the button makes, by name and type (review F): a JPEG screenshot and a
    // recorded voice note, never an SVG or any other file to host. `create`
    // also covers writing over an existing file's content (only metadata
    // changes are `update`), so a new file is required: `resource == null`.
    function isFeedbackUpload(fileName) {
      return resource == null && ((fileName == 'screenshot.jpg'
          && request.resource.contentType == 'image/jpeg'
          && request.resource.size < 5 * 1024 * 1024)
        || (fileName.matches('voice[.](mp4|webm|ogg)')
          && request.resource.contentType.matches('audio/(mp4|webm|ogg|aac)')
          && request.resource.size < 10 * 1024 * 1024));
    }
    match /users/{userDocId}/feedback/{feedbackId}/{fileName} {
      allow create: if ownsUserRecord(userDocId) && isFeedbackUpload(fileName);
    }
    match /{prefix}/users/{userDocId}/feedback/{feedbackId}/{fileName} {
      allow create: if ownsUserRecord(userDocId) && isFeedbackUpload(fileName);
    }

    // Member profile photos. A signed-in user may write images only in their
    // own folder; the profile page stores the download URL in users.photo.
    match /avatars/{uid}/{fileName} {
      allow write: if isAuthenticated() && request.auth.uid == uid
        && (request.resource == null || isSmallImage());
    }

    // App rules. `npm run rules:build` (run by every deploy) puts the
    // install's storage.app.rules here. Keep the marker on a line of its own.
    // @arc-app-rules
  }
}
